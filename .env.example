# Copy this file to .env and fill in your values.
# Then add these as Environment Variables in your Vercel project dashboard.

# Your Shopify store URL (without https://)
SHOPIFY_STORE_URL=yourstore.myshopify.com

# Admin API access token from your Shopify Custom App
# Required scopes: write_metaobject_definitions, write_metaobjects, read_metaobjects
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# Your Shopify storefront URL — used for CORS (prevents other sites from using your API)
ALLOWED_ORIGIN=https://yourstore.myshopify.com

# A random secret string shared between your theme JS and this API
# Generate one at: https://passwordsgenerator.net/ (use 32+ chars, no special chars)
WISHLIST_API_SECRET=your_random_secret_here_32chars

# A separate secret for the one-time /api/setup endpoint
SETUP_SECRET=your_setup_secret_here

# ─── Email reminders (Gmail) ─────────────────────────────────────────────────
# Gmail / Google Workspace address that sends the reminder emails
GMAIL_USER=care@yourstore.com
# 16-character Google App Password: https://myaccount.google.com/apppasswords (2-Step Verification must be on)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Secret Vercel Cron uses to call /api/cron-reminders (any random string; Vercel sends it automatically)
CRON_SECRET=another_random_secret
# Public https address of this deployment, used for the unsubscribe link
PUBLIC_API_URL=https://your-vercel-app.vercel.app
# Optional
# STORE_NAME=Your Store
# STORE_URL=https://yourstore.com
# WISHLIST_PAGE_PATH=/pages/wishlist
# EMAIL_FROM_NAME=Your Store
# EMAIL_REPLY_TO=care@yourstore.com
# EMAIL_LOGO_URL=https://yourstore.com/logo.png
# REMINDER_DELAY_HOURS=24
# REMINDER_MIN_GAP_DAYS=3
# EMAIL_TEMPLATE_JSON={"subject":"{{customer_name}}, your wishlist is waiting","design":{"headerBg":"#000000"}}
